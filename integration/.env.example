# LLM Providers (at least one needed for real responses)
# If neither is set, a mock provider generates canned responses
OPENAI_API_KEY=
# Optional: custom OpenAI-compatible endpoint (OpenRouter, Together, etc)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Dalai local LLM (optional, for private inference)
# Start with: npx dalai serve 3001
DALAI_URL=http://localhost:3001
DALAI_MODEL=7B

# Eros-engine sidecar (optional, for advanced relationship model)
# Start eros-engine Rust binary separately
EROS_API_URL=

# ElevenLabs TTS (optional, for voice)
ELEVEN_LABS_API_KEY=

# Server
PORT=3000
